#!/bin/bash
# Pre-push hook: 格式检查（全量）+ lint（src/）+ 单元/集成测试（全量）
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

echo "=== [pre-push] ruff 格式检查（全量）==="
uv run ruff format --check .

echo "=== [pre-push] ruff lint 检查（src/）==="
uv run ruff check src/

echo "=== [pre-push] 单元测试（全量）==="
uv run pytest tests/ -q -m "not integration"

echo "=== [pre-push] 集成测试（全量）==="
uv run pytest tests/ -q -m "integration"

echo "=== [pre-push] E2E smoke（入口点验证）==="
uv run pytest tests/e2e/ -q -m e2e

echo "=== [pre-push] ✅ 全部通过 ==="
