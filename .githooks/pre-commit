#!/bin/bash
# Pre-commit hook: 仅快速层（格式化 + lint），不跑测试。
# 完整门禁（单元/集成/e2e）在 pre-push 阶段执行（与 CI 对齐）。
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

# 记录本次提交已暂存的文件（NUL 分隔，兼容含空格/换行的路径）。
# ruff format / check --fix 会改动工作树，稍后只重新 stage 这些文件，
# 避免把未暂存的改动意外带入本次提交（支持部分提交）。
# 注意：bash 变量无法保留 NUL 字节，必须用临时文件中转，
# 否则 xargs -0 会把所有文件名拼成一个 pathspec。
STAGED_FILES_FILE="$(mktemp)"
trap 'rm -f "$STAGED_FILES_FILE"' EXIT
git diff --cached --name-only -z --diff-filter=ACMR > "$STAGED_FILES_FILE"

echo "=== [pre-commit] ruff format（自动修复）==="
uv run ruff format .

echo "=== [pre-commit] ruff check --fix（辅助修复，不阻塞）==="
uv run ruff check --fix --exit-zero .

# 只重新 stage 原本已暂存的文件（它们可能被上面的 format/--fix 改动过）
if [ -s "$STAGED_FILES_FILE" ]; then
    xargs -0 -r git add < "$STAGED_FILES_FILE"
fi

echo "=== [pre-commit] ✅ 快速检查通过（完整门禁见 pre-push）==="
